          "rawQuery": true,
          "rawSql": "WITH latest AS (SELECT timestamp, processed_messages_total, sensor_messages_total, throughput_kbps, estimated_latency_ms, packet_loss_percent, mqtt_health FROM network_metrics ORDER BY timestamp DESC LIMIT 1) SELECT timestamp AS measured_at, processed_messages_total, sensor_messages_total, throughput_kbps, estimated_latency_ms, packet_loss_percent, CASE WHEN mqtt_health = 1 THEN 'healthy' ELSE 'offline' END AS mqtt_health FROM latest;",
